# ==============================================================================
# SentinelDLP - Environment Configuration Template (.env.example)
# Phase 1: Foundation and Core Architecture
# ==============================================================================
# Copy this file to '.env' and adjust the values for your environment.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Application Metadata
APP_NAME=SentinelDLP
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration (Comma-separated list of allowed origins)
# For local frontend development, Vite runs on http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Note: For containerized deployment, host should match the docker service name (e.g. 'db')
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_secure_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentineldlp

# Combined SQLAlchemy Database URL
DATABASE_URL=postgresql+psycopg2://sentinel_user:sentinel_secure_dev_password@localhost:5432/sentineldlp

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=5

# Frontend Configuration (Used when building or running frontend)
VITE_API_BASE_URL=http://localhost:8000
