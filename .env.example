# ==============================================================================
# SentinelDLP - Master Environment Configuration Template (.env.example)
# Version: v1.0.0 (Production & Local Demonstration Ready)
# ==============================================================================
# Copy this file to '.env' and adjust the values for your deployment.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Metadata & Environment
# ------------------------------------------------------------------------------
APP_NAME=SentinelDLP
APP_VERSION=1.0.0
# Options: development, testing, staging, production
ENVIRONMENT=development
# In production, DEBUG MUST be false (validated on startup)
DEBUG=false
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. Server & Network Bindings
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# For container deployment: POSTGRES_HOST=db; For local host: POSTGRES_HOST=localhost
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_secure_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentineldlp
DATABASE_URL=postgresql+psycopg2://sentinel_user:sentinel_secure_dev_password@localhost:5432/sentineldlp

# Connection Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# 4. Authentication, RBAC & API Security (Phase 11)
# ------------------------------------------------------------------------------
# Set AUTH_ENABLED=true to activate token/key validation
AUTH_ENABLED=true
# In production, AUTH_ENFORCED is always strictly required
AUTH_ENFORCED=false

# Role-Based API Keys (Replace with strong random strings in production)
ADMIN_API_KEY=sentinel_admin_key_dev_sec
ANALYST_API_KEY=sentinel_analyst_key_dev_sec
READONLY_API_KEY=sentinel_readonly_key_dev_sec

# Request Payload Limits & Sliding-Window Rate Limiting
MAX_REQUEST_BODY_BYTES=10485760  # 10 MB payload ceiling (HTTP 413)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300

# ------------------------------------------------------------------------------
# 5. File Scanning & Directory Containment (Phase 2 & Phase 3)
# ------------------------------------------------------------------------------
MAX_FILES_PER_SCAN=10000
MAX_FILE_SIZE_BYTES=104857600   # 100 MB max file size for streaming SHA-256
MAX_SCAN_DURATION_SECONDS=300   # 5-minute wall-clock timeout
CHUNK_SIZE_BYTES=65536          # 64 KB streaming buffer

# Optional JSON string overriding authorized scan directories
# AUTHORIZED_SCAN_ROOTS_JSON='{"synthetic_samples":{"name":"Synthetic Samples","path":"./sample_data"}}'

# ------------------------------------------------------------------------------
# 6. AI SOC Analyst Configuration (Phase 9)
# ------------------------------------------------------------------------------
# Provider: 'mock' (deterministic offline) or 'ollama' (local inference)
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_MODEL=llama3.2:3b
AI_MAX_TOOL_CALLS_PER_INVESTIGATION=6
AI_EVIDENCE_CONTEXT_MAX_CHARS=4000

# ------------------------------------------------------------------------------
# 7. Cyberattack Simulation Laboratory (Phase 10)
# ------------------------------------------------------------------------------
SIMULATION_ROOT_NAME=simulation_lab
SIMULATION_MAX_FILES_PER_RUN=50
SIMULATION_MAX_BYTES_PER_RUN=52428800  # 50 MB
SIMULATION_TIMEOUT_SECONDS=60
# Simulations are blocked in production by default; set true only for authorized lab tests
ALLOW_PRODUCTION_SIMULATION=false

# ------------------------------------------------------------------------------
# 8. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=sentinel_admin_key_dev_sec
